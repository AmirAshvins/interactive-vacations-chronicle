PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Local Docker Postgres (docker compose up -d)
DATABASE_URL=postgresql://ivc:ivc_dev@localhost:5432/ivc_dev

# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-use-openssl-rand-hex-32-min-length
JWT_SECRET=change-me-use-openssl-rand-hex-32-min-length
JWT_ACCESS_TTL_SECONDS=900
SESSION_COOKIE_NAME=ivc_session

# Image storage — omit R2 vars to use local disk (.data/ivc-uploads) in development
# STORAGE_PUBLIC_BASE_URL=http://localhost:4000/storage/media
# LOCAL_STORAGE_DIR=.data/ivc-uploads
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ivc-images
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_BASE_URL=https://cdn.yourdomain.com

    "@ivc/shared": "0.0.0",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.1",
    "graphql-ws": "^6.0.8",
    "graphql-yoga": "^5.21.1",
    "jose": "^6.2.3",
    "lucia": "^3.2.2",
    "postgres": "^3.4.9",
